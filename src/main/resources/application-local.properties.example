# Copie este archivo como application-local.properties y complete los valores.
# application-local.properties está en .gitignore y no se sube a GitHub.
# En la nube use las mismas claves como variables de entorno (DB_URL, DB_PASSWORD, MAIL_PASSWORD, API_PERU_TOKEN).
